/* styles.css — Professional Fresher Portfolio
   Light + Dark theme handled by JS toggling html.dark / html.light */

/* ---------- LIGHT THEME DEFAULT ---------- */
:root {
  --bg: #f7f7f6;
  --panel: #ffffff;
  --muted: #55606a;
  --text: #0f1720;
  --accent: #0b4a6f;
  --accent-2: #7b61ff;
  --ghost: rgba(11,74,111,0.06);
  --input-bg: #ffffff;
  --input-border: rgba(15,23,36,0.06);
  --radius: 12px;
  --shadow: 0 8px 22px rgba(15,23,36,0.08);
  --soft-shadow: 0 6px 18px rgba(15,23,36,0.06);
  --maxw: 1100px;
  --card-bg: var(--panel);
  color-scheme: light;
}

/* ---------- DARK THEME (applied with html.dark) ---------- */
html.dark {
  --bg: linear-gradient(135deg, #0d1b2a 0%, #172a3f 45%, #3b5774 100%);
  --panel: rgba(255,255,255,0.04);
  --muted: #b7c3d2;
  --text: #eaf1f8;
  --accent: #4cc9f0;
  --accent-2: #7b61ff;
  --ghost: rgba(76,201,240,0.08);
  --input-bg: rgba(255,255,255,0.03);
  --input-border: rgba(255,255,255,0.04);
  --shadow: 0 10px 30px rgba(2,6,23,0.55);
  --soft-shadow: 0 6px 18px rgba(2,6,23,0.45);
  --card-bg: var(--panel);
  color-scheme: dark;
}

/* ---------- BASE ---------- */
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  background: var(--bg);
  color: var(--text);
  line-height: 1.55;
  font-size: 16px;
  -webkit-font-smoothing:antialiased;
  padding-bottom: 60px;
  transition: background .35s ease, color .25s ease;
}

/* container */
.container { max-width: var(--maxw); margin: 0 auto; padding: 28px 20px; }

/* typography utils */
.lead { color: var(--muted); font-size: 15px; max-width: 66ch; }
.muted { color: var(--muted); font-size: 14px; }
.small { font-size: 14px; color: var(--muted); }

/* ---------- HEADER ---------- */
.site-header{
  position: sticky; top: 0; z-index: 90;
  background: linear-gradient(180deg, rgba(255,255,255,0.85), rgba(255,255,255,0.8));
  border-bottom: 1px solid rgba(15,23,36,0.06);
  backdrop-filter: blur(6px);
}
html.dark .site-header {
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  border-bottom: 1px solid rgba(255,255,255,0.02);
}
.header-inner { display:flex; gap:16px; align-items:center; justify-content:space-between; }
.brand { font-weight:800; font-size:18px; color: var(--text); text-decoration:none; letter-spacing:0.2px; }
.brand .accent { display:inline-block; margin-left:8px; font-weight:900; color:var(--accent-2); }

/* nav */
.nav { display:flex; gap:14px; align-items:center; }
.nav a {
  color: var(--muted); text-decoration:none; font-weight:600; padding:8px 10px; border-radius:8px; transition: all .16s ease;
}
.nav a:hover { color: var(--text); background: var(--ghost); transform: translateY(-2px); }
.nav .cta {
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
  color: #021226; padding:8px 12px; border-radius:10px; font-weight:800;
  box-shadow: 0 8px 22px rgba(11,74,111,0.08);
}
.theme-btn { background:transparent; border:0; color:var(--muted); font-size:16px; cursor:pointer; padding:6px; border-radius:8px; }

/* mobile nav button */
.nav-toggle { display:none; background:transparent; border:0; color:var(--muted); font-size:20px; cursor:pointer; }
@media (max-width: 920px) {
  .nav { display:none; position:absolute; right:18px; top:68px; background:var(--card-bg); border-radius:12px; padding:12px; box-shadow:var(--shadow); flex-direction:column; width:220px; }
  .nav.open{ display:flex; }
  .nav-toggle{ display:block; }
}

/* ---------- HERO ---------- */
.hero { padding: 64px 0 40px; }
.hero-grid { display:grid; grid-template-columns: 1fr 340px; gap:28px; align-items:start; }
.intro h1 {
  font-size:36px; line-height:1.02; margin-bottom:10px; font-weight:700;
  font-family: Georgia, 'Times New Roman', serif; color:var(--text);
}
.accent { background: linear-gradient(90deg, var(--accent), var(--accent-2)); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }
.hero-actions { display:flex; gap:12px; margin-bottom:16px; }

/* buttons */
.btn { display:inline-flex; align-items:center; gap:8px; padding:10px 14px; border-radius:10px; text-decoration:none; font-weight:700; cursor:pointer; transition: transform .12s ease, box-shadow .12s ease; }
.btn:active{ transform: translateY(1px); }
.btn-primary { background: linear-gradient(90deg, var(--accent), var(--accent-2)); color:#021226; box-shadow: 0 10px 28px rgba(76,201,240,0.12); }
.btn-outline { background: transparent; border: 1px solid rgba(15,23,36,0.06); color: var(--text); }

/* ---------- CARDS ---------- */
.card { background: var(--card-bg); border-radius: var(--radius); padding:18px; box-shadow: var(--soft-shadow); border: 1px solid rgba(0,0,0,0.03); transition: background .25s ease, color .2s ease; }
html.dark .card { border: 1px solid rgba(255,255,255,0.02); }

.hero-card .profile { display:flex; gap:12px; align-items:center; margin-bottom:12px; }
.avatar { width:64px; height:64px; border-radius:12px; display:flex; align-items:center; justify-content:center; background: linear-gradient(135deg, var(--accent), var(--accent-2)); color:#fff; font-weight:800; font-size:20px; }
.profile h3 { margin:0; font-size:18px; color:var(--text); }
.skill-tags { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px; }
.skill-tags span { background: rgba(11,74,111,0.06); padding:6px 10px; border-radius:999px; color:var(--accent); font-weight:700; font-size:13px; }

/* ---------- SECTIONS ---------- */
.section { padding:44px 0; }
.section h2 { margin-bottom:18px; font-size:22px; font-family: Georgia, serif; color:var(--text); }

/* about */
.about-grid { display:grid; grid-template-columns: 1fr 300px; gap:22px; align-items:start; }
.metric { background: var(--panel); padding:12px 16px; border-radius:12px; text-align:center; border: 1px solid rgba(0,0,0,0.03); }
.metric .num { font-weight:800; font-size:20px; color:var(--accent); }

/* education */
.education-list { display:grid; gap:16px; margin-top:12px; }
.edu { border-left: 3px solid var(--accent); padding:14px; }

/* projects */
.projects-grid { display:grid; grid-template-columns: repeat(3,1fr); gap:18px; margin-top:12px; }
.project img { width:100%; height:160px; object-fit:cover; border-radius:10px; margin-bottom:12px; }
.p-body h3 { margin:0 0 6px; color:var(--text); }
.project-meta { display:flex; gap:8px; align-items:center; justify-content:space-between; margin-top:12px; }
.project-meta span { background: rgba(15,23,36,0.03); padding:6px 8px; border-radius:8px; font-size:13px; color:var(--muted); }
.link { color:var(--accent); text-decoration:none; font-weight:700; }

/* skills */
.skill-grid { display:grid; grid-template-columns: repeat(3,1fr); gap:16px; margin-top:12px; }
.skill.card { padding:16px; }

/* contact */
.contact-grid { display:grid; grid-template-columns: 1fr 320px; gap:18px; align-items:start; }
.contact-card h2 { margin-bottom:6px; }
.contact-form label { display:block; margin-bottom:12px; font-weight:600; color:var(--text); }
.contact-form input, .contact-form textarea {
  width:100%; padding:12px 14px; border-radius:10px; background: var(--input-bg); border:1px solid var(--input-border); color:var(--text); font-size:15px;
  transition: box-shadow .12s ease, border-color .12s ease;
}
.contact-form input:focus, .contact-form textarea:focus {
  box-shadow: 0 8px 20px rgba(11,74,111,0.08); border-color: rgba(11,74,111,0.18); outline:none;
}
.form-actions { display:flex; gap:12px; margin-top:8px; }

/* footer */
.site-footer { border-top:1px solid rgba(15,23,36,0.06); padding:18px 0; color:var(--muted); text-align:center; }

/* focus states */
a:focus, button:focus, input:focus, textarea:focus { outline: 3px solid rgba(11,74,111,0.12); outline-offset:3px; }

/* responsive */
@media (max-width: 1100px) {
  .projects-grid { grid-template-columns: repeat(2,1fr); }
  .about-grid { grid-template-columns: 1fr; }
  .skill-grid { grid-template-columns: repeat(2,1fr); }
  .hero-grid { grid-template-columns: 1fr 300px; }
}
@media (max-width: 760px) {
  .hero-grid { grid-template-columns: 1fr; }
  .projects-grid { grid-template-columns: 1fr; }
  .contact-grid { grid-template-columns: 1fr; }
  .avatar { width:56px; height:56px; }
  .intro h1 { font-size:28px; }
}

/* -- tweak theme by editing :root and html.dark variables -- */
/* ---------- CERTIFICATIONS SECTION ---------- */
.cert-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  margin-top: 12px;
}

@media (max-width: 760px) {
  .cert-grid {
    grid-template-columns: 1fr;
  }
}

/* ---------- MODAL POPUP ---------- */
.modal {
  display: none; 
  position: fixed;
  z-index: 5000;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.65);
  backdrop-filter: blur(4px);
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.modal.show {
  display: flex;
  animation: fadeIn .3s ease;
}

.modal-content {
  background: var(--panel);
  padding: 12px;
  border-radius: 12px;
  max-width: 550px;
  width: 100%;
  box-shadow: var(--shadow);
  position: relative;
  animation: zoomIn .25s ease;
}

.modal-content img {
  width: 100%;
  border-radius: 10px;
}

.modal-close {
  position: absolute;
  top: 5px;
  right: 12px;
  font-size: 28px;
  cursor: pointer;
  color: var(--text);
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes zoomIn {
  from { transform: scale(0.85); opacity: 0; }
  to   { transform: scale(1); opacity: 1; }
}
/* Small Button */
.btn-small {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 6px 10px;        /* smaller padding */
  font-size: 13px;          /* smaller text */
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  cursor: pointer;
  border: 1px solid rgba(255,255,255,0.25);
  background: transparent;
  color: var(--text);
  transition: 0.2s;
}

.btn-small:hover {
  background: rgba(255,255,255,0.08);
  transform: translateY(-1px);
}

.icon-small {
  width: 14px;
  height: 14px;
}
.quick-small-buttons {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 10px;
}

.btn-small {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 10px; 
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  background: transparent;
  border: 1px solid rgba(255,255,255,0.22);
  border-radius: 8px;
  text-decoration: none;
  cursor: pointer;
  transition: 0.2s;
}

.btn-small:hover {
  background: rgba(255,255,255,0.12);
  transform: translateY(-1px);
}

.icon-small {
  width: 14px;
  height: 14px;
}
/* HEADER: fixed + layout variables */
:root {
  --header-height: 72px; /* adjust if your header is taller/shorter */
}

/* Fixed header */
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: var(--header-height);
  z-index: 9999;
  background: linear-gradient(180deg, rgba(255,255,255,0.85), rgba(255,255,255,0.82));
  backdrop-filter: blur(6px);
  border-bottom: 1px solid rgba(15,23,36,0.06);
}

/* If you use dark theme handle this too */
html.dark .site-header {
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  border-bottom: 1px solid rgba(255,255,255,0.02);
}

/* push main content below the fixed header */
body {
  /* keep any existing padding-top if present — this will overwrite */
  padding-top: var(--header-height);
  transition: padding-top .2s;
}

/* ensure each section scrolls into view below header */
section, .section {
  scroll-margin-top: calc(var(--header-height) + 12px); /* 12px extra breathing room */
}

/* mobile tweak (if header height changes on small screens) */
@media (max-width: 760px) {
  :root { --header-height: 64px; } /* smaller header on mobile if needed */
  section, .section { scroll-margin-top: calc(var(--header-height) + 8px); }
}

/* Optional: small shadow while scrolling */
.site-header.scrolled {
  box-shadow: 0 6px 18px rgba(2,6,23,0.12);
}
